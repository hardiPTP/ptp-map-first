# Copy to .env and fill in. Never commit .env.

# Required: Google Maps Demo Key (developers.google.com/maps/demo-key)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a cloud-styled Map ID. Leave empty to use the fallback map mode.
VITE_GOOGLE_MAP_ID=

# Optional until deploy: Firebase web config. Leave empty to build on the emulator (project id demo-ptp).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
